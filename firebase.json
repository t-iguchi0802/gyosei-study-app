{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "行政書士2026 学習アプリ",
        "supportEmail": "t.iguchi@sunarrows-tky.co.jp"
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast1",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "firestore.rules",
      "server.js",
      "start-app.ps1",
      "README.md",
      "storage/**",
      "tools/**",
      ".git/**",
      "firebase-debug.log"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
